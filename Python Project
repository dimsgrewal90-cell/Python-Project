# Load dataset using pandas
import pandas as pd
df = pd.read_csv(f'{path}/creditcard.csv')
df.head()

# Data cleaning in pandas
df.info()

# Displaying first rows
df.head()

# Checking missing values
df.isnull().sum()

# Remove missing values
df = df.dropna()
df.isnull().sum()

# check datatypes
df.dtypes

# Remove duplicates rows
df.drop_duplicates(inplace=True)
df.shape

# Import Matplotlib
# 1: Line Chart
import matplotlib.pyplot as plt
plt.plot(df['Time'], df['Amount'])
plt.xlabel('Time')
plt.ylabel('Amount')
plt.title('Time vs Amount')
plt.grid(True)
plt.show()

# Changing properties
plt.plot(df['Time'], df['Amount'], color='red', marker='o', linestyle='--', linewidth=0.4)

# 2: Bar Chart
plt.bar(df['Time'], df['Amount'], color='orange', edgecolor='black', linewidth=1)
plt.title('Time vs Amount')
plt.xlabel('Time')
plt.ylabel('Amount')
plt.show()

# 3: Histogram
plt.hist(df['Amount'], bins=1, color='green', edgecolor='black')
plt.title('Amount Distribution')
plt.xlabel('Amount')
plt.ylabel('Frequency')
plt.show()

# 4: Scatter plot
plt.scatter(df['Time'], df['Amount'], color='blue', marker='o', s=10)
plt.title('Time vs Amount')
plt.xlabel('Time')
plt.ylabel('Amount')
plt.show()

# 5: Pie Chart
labels = ['Class 0', 'Class 1']
sizes = df['Class'].value_counts()
colors = ['lightcoral', 'lightskyblue']
explode = (0.1, 0)
plt.pie(sizes, labels=labels, colors=colors, explode=explode, autopct='%1.1f%%', shadow=True,
        startangle=140)
plt.axis('equal')
plt.title('Class Distribution')
plt.show()

